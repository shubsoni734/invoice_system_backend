# Copy to .env and fill in the values before you run the API.
# cp .env.example .env

SERVER_PORT=8080
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgres://user:password@localhost:5432/invoice?sslmode=disable
DB_MIN_CONNS=5
DB_MAX_CONNS=25
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Use at least 32 characters when ENVIRONMENT=production
ORG_JWT_SECRET=
SA_JWT_SECRET=
ORG_ACCESS_TOKEN_EXPIRY=15m
ORG_REFRESH_TOKEN_EXPIRY=168h
SA_ACCESS_TOKEN_EXPIRY=15m
SA_REFRESH_TOKEN_EXPIRY=24h

RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_API_RPM=300

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=2

WHATSAPP_API_URL=
WHATSAPP_API_KEY=

LOG_LEVEL=info
LOG_FORMAT=json

# Comma-separated. Leave empty to allow every IP.
SA_IP_ALLOWLIST=

# Required in production. Send it as the X-Bootstrap-Secret header
# when calling POST /superadmin/auth/create. Leave empty in local development.
SA_BOOTSTRAP_SECRET=

# Brevo email. SMTP is used when the SMTP login and key are set.
# Leave these blank until you are ready; the API still starts.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Invoice Flow
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Exposes POST /api/v1/common/test-email. Keep false for customers.
ENABLE_TEST_EMAIL=false

# Secret path for the sample-email page. Leave empty to keep that page off.
# Use the same value as VITE_EMAIL_TEST_TOKEN in the frontend.
EMAIL_TEST_TOKEN=

# Browser push alerts. Generate a VAPID key pair and paste it here.
# In-app notifications work without these keys.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@localhost
